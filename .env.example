# Neon PostgreSQL. Use a dedicated runtime role for the application.
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@YOUR-NEON-HOST/DB_NAME?sslmode=require
# Auth.js v5
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
# Email sign-in (SMTP)
AUTH_EMAIL_FROM=IngenieroAI <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
