# IngenieroAI.pro — copy these names into Vercel Environment Variables.
# Never commit a real value into GitHub. Keep the repository private.

# Neon PostgreSQL. Dedicated restricted runtime user only.
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@YOUR-NEON-HOST/neondb?sslmode=verify-full&channel_binding=require

# Auth.js v5
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=https://ingenieroai-pro.vercel.app
APP_BASE_URL=https://ingenieroai-pro.vercel.app

# Email magic-link login and email verification (required for registration)
AUTH_EMAIL_FROM=IngenieroAI.pro <no-reply@your-verified-domain.com>
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me

# Payments stay disabled until a complete sandbox flow succeeds.
BILLING_PAYMENTS_ENABLED=false

# Recurrente sandbox API key from its test/sandbox environment
RECURRENTE_SECRET_KEY=sk_test_replace_me
# Recurrente webhook signing secret (whsec_...) obtained when creating the webhook endpoint
RECURRENTE_WEBHOOK_SECRET=whsec_replace_me

# PayPal sandbox credentials
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=replace-me
PAYPAL_CLIENT_SECRET=replace-me
PAYPAL_WEBHOOK_ID=replace-me
